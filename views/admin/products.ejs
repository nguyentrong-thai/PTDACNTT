<%- include('../partials/header') %>
<section class="page-heading"><p class="eyebrow">QUẢN TRỊ SẢN PHẨM</p><h1>Kho sản phẩm</h1><p class="muted">Theo dõi tồn kho và cập nhật thông tin sản phẩm.</p></section>
<div class="section-row"><h2>Danh sách sản phẩm</h2><a class="btn btn-primary" href="/admin/products/new">+ Thêm sản phẩm</a></div>
<div class="admin-table product-admin-table"><% if (!products.length) { %><div class="empty-state"><h2>Chưa có sản phẩm</h2></div><% } %><% products.forEach((product) => { %><div class="table-row"><div class="admin-product"><img src="<%= product.image_url || '/images/no-image.svg' %>" alt="<%= product.name %>"><div><strong><%= product.name %></strong><small><%= product.category_name %> · Nhà sản xuất: <%= product.brand || 'Chưa cập nhật' %></small><small><%= Number(product.price).toLocaleString('vi-VN') %> đ · Tồn kho: <%= product.stock_qty %></small></div></div><div class="admin-product-actions"><span class="order-status <%= product.is_active ? '' : 'status-cancelled' %>"><%= product.is_active ? 'Đang bán' : 'Đã ẩn' %></span><a class="text-button" href="/admin/products/<%= product.id %>/edit">Sửa</a><form class="inline-form" method="post" action="/admin/products/<%= product.id %>/delete" onsubmit="return confirm('Sản phẩm đã có trong đơn hàng sẽ không thể xóa. Tiếp tục?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">Xóa</button></form></div></div><% }) %></div>
<%- include('../partials/pagination') %><%- include('../partials/footer') %>