<%- include('../partials/header') %>
<section class="page-heading"><p class="eyebrow">KHU VỰC QUẢN TRỊ</p><h1>Quản lý nhân viên</h1><p class="muted">Quản lý thông tin và tài khoản nhân viên trong hệ thống.</p></section>
<div class="admin-actions"><a class="btn btn-primary" href="/admin/users/new">+ Thêm nhân viên</a><a class="cancel-link" href="/admin">Về dashboard</a><label class="admin-inline-search"><span class="visually-hidden">Tìm kiếm nhân viên</span><input data-user-search type="search" placeholder="Tìm nhân viên"></label></div>
<div class="admin-table employee-admin-table"><% if (!employees.length) { %><div class="empty-state"><h2>Chưa có nhân viên</h2><p>Hãy tạo tài khoản nhân viên đầu tiên.</p></div><% } %><% employees.forEach((employee) => { %><div class="table-row employee-row" data-user-row><div><strong>#<%= employee.id %> · <%= employee.full_name %></strong><small><%= employee.position || 'Chưa có chức vụ' %> · <%= employee.gender === 'male' ? 'Nam' : employee.gender === 'female' ? 'Nữ' : employee.gender === 'other' ? 'Khác' : 'Chưa chọn' %> · <%= employee.date_of_birth ? new Date(employee.date_of_birth).toLocaleDateString('vi-VN') : 'Chưa có ngày sinh' %></small><small><%= employee.phone || 'Chưa có số điện thoại' %> · <%= employee.address || 'Chưa có địa chỉ' %> · <%= employee.email %></small></div><div><a class="text-button" href="/admin/users/<%= employee.id %>/edit">Sửa</a><form class="inline-form" method="post" action="/admin/users/<%= employee.id %>/delete" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">Xóa</button></form></div></div><% }) %></div>
<script src="/js/admin-users.js" defer></script>
<%- include('../partials/footer') %>
