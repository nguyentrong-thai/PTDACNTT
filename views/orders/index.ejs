<%- include('../partials/header') %>
<section class="page-heading"><p class="eyebrow">LỊCH SỬ MUA HÀNG</p><h1>Đơn hàng của tôi</h1></section>
<form class="section-row" method="get" action="/orders" data-auto-submit>
  <label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Chờ duyệt</option><option value="confirmed" <%= status === 'confirmed' ? 'selected' : '' %>>Đã duyệt</option><option value="shipping" <%= status === 'shipping' ? 'selected' : '' %>>Đang giao</option><option value="completed" <%= status === 'completed' ? 'selected' : '' %>>Hoàn tất</option><option value="cancelled" <%= status === 'cancelled' ? 'selected' : '' %>>Đã hủy</option></select></label>
  <button class="text-button" type="submit">Lọc</button>
</form>
<div class="admin-table"><% if (!orders.length) { %><div class="empty-state"><h2><%= status ? 'Không có đơn hàng phù hợp' : 'Bạn chưa có đơn hàng nào' %></h2><a class="btn btn-primary" href="/products">Mua sắm ngay</a></div><% } %><% orders.forEach((order) => { %><div class="table-row order-row"><div><strong>Đơn hàng #<%= order.id %></strong><small><%= new Date(order.created_at).toLocaleString('vi-VN') %> · <%= Number(order.total_amount).toLocaleString('vi-VN') %> đ</small><a class="text-button" href="/orders/<%= order.id %>">Xem chi tiết</a></div><div><span class="order-status status-<%= order.status %>"><%= { pending: 'Chờ duyệt', confirmed: 'Đã duyệt', shipping: 'Đang giao', completed: 'Hoàn tất', cancelled: 'Đã hủy' }[order.status] %></span><% if (order.status === 'pending') { %><form method="post" action="/orders/<%= order.id %>/cancel" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-button" type="submit">Hủy đơn</button></form><% } %></div></div><% }) %></div>
<%- include('../partials/pagination') %><%- include('../partials/footer') %>