<%- include('../partials/header') %>
<section class="page-heading"><div><p class="eyebrow">BỘ SƯU TẬP ELECTROSHOP</p><h1>Tìm thiết bị hợp với bạn</h1><p class="muted">Chọn từ những sản phẩm công nghệ được tuyển chọn cho học tập, công việc và giải trí.</p></div></section>
<form class="filter-bar" method="get" action="/products"><label class="search-field"><span>Tìm kiếm</span><input type="search" name="search" value="<%= filters.search %>" placeholder="Tên, mô tả hoặc nhà sản xuất"></label><label><span>Danh mục</span><select name="category"><option value="">Tất cả danh mục</option><% categories.forEach((cat) => { %><option value="<%= cat.slug %>" <%= filters.category === cat.slug ? 'selected' : '' %>><%= cat.name %></option><% }) %></select></label><label><span>Nhà sản xuất</span><select name="brand"><option value="">Tất cả nhà sản xuất</option><% brands.forEach((brand) => { %><option value="<%= brand %>" <%= filters.brand === brand ? 'selected' : '' %>><%= brand %></option><% }) %></select></label><button class="btn" type="submit">Lọc sản phẩm</button></form>
<div class="section-row"><h2><%= pagination.total %> sản phẩm</h2><a href="/products">Xóa bộ lọc</a></div><div class="product-grid"><% products.forEach((product) => { %><article class="product-card"><a class="product-image" href="/products/<%= product.id %>"><img src="<%= product.image_url || '/images/no-image.svg' %>" alt="<%= product.name %>"></a><div class="product-copy"><p class="product-category"><%= product.category_name %></p><h3><a href="/products/<%= product.id %>"><%= product.name %></a></h3><p class="brand"><%= product.brand %></p><div class="product-bottom"><strong class="price"><%= Number(product.price).toLocaleString('vi-VN') %> đ</strong><span class="stock"><%= product.stock_qty > 0 ? 'Còn hàng' : 'Hết hàng' %></span></div></div></article><% }); %></div>
<% if (!products.length) { %><div class="empty-state"><h2>Chưa tìm thấy sản phẩm</h2><p>Thử một từ khóa hoặc danh mục khác.</p></div><% } %><%- include('../partials/pagination') %><%- include('../partials/footer') %>