<section class="assistant-widget" data-assistant-widget aria-label="Tư vấn sản phẩm">
  <button class="assistant-toggle" type="button" data-assistant-toggle aria-expanded="false" aria-controls="assistant-panel"><i class="fas fa-comments" aria-hidden="true"></i><span>Tư vấn</span></button>
  <div class="assistant-panel" id="assistant-panel" data-assistant-panel hidden>
    <div class="assistant-heading"><div><strong>Tư vấn sản phẩm</strong><small>Gợi ý theo danh mục và ngân sách</small></div><button type="button" data-assistant-close aria-label="Đóng tư vấn"><i class="fas fa-times" aria-hidden="true"></i></button></div>
    <div class="assistant-messages" data-assistant-messages aria-live="polite"><p class="assistant-message assistant-message--bot">Chào bạn! Bạn đang tìm sản phẩm nào, hoặc có ngân sách khoảng bao nhiêu?</p></div>
    <form class="assistant-form" data-assistant-form><label class="visually-hidden" for="assistant-question">Nội dung cần tư vấn</label><input id="assistant-question" name="message" maxlength="200" placeholder="Ví dụ: laptop dưới 20 triệu" required><button type="submit" aria-label="Gửi câu hỏi"><i class="fas fa-paper-plane" aria-hidden="true"></i></button></form>
  </div>
</section>