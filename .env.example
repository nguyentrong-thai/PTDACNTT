NODE_ENV=development
PORT=3000

# Local development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=electro_shop

# Production can use DB_* variables or Railway's MYSQL* variables.
# DATABASE_URL or MYSQL_URL can also be used instead of separate DB settings.

# Local uploads are stored in public/images/products.
UPLOAD_DIR=public/images/products

# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
